# WonderBox cloud backend (services/backend_client.py)
# The Pi no longer calls OpenAI or runs Whisper; the backend does both.
# Use the computer's network name (.local), not its number, so it keeps working
# on any Wi-Fi, e.g. a phone hotspot (the number changes from network to network).
BACKEND_URL=http://Karthiks-MacBook-Air.local:8000
# Raw token returned once by POST /device/register
DEVICE_TOKEN=your-device-token-here
# Child profile id the backend requires on every sticker submit
CHILD_ID=1
# stream (default): spoken words show on the thinking screen about 1 s in,
# while the picture is made. direct: one request, words only arrive at the end.
# AI_BACKEND_MODE=stream

# Printer (optional)
# PRINTER_PORT=/dev/ttyUSB0
# PRINTER_SIMULATE=0
# Pause after each 1,160-byte strip, seconds
# PRINTER_STRIP_DELAY=0.08
# How pictures are sent: band (default, crisp black) or raster (old way;
# came out grey and dotted on the demo printer)
# PRINTER_IMAGE_MODE=band

# Screen (defaults suit the original 600x600 panel)
# SCREEN_W=310
# SCREEN_H=480
# SCREEN_ROTATE_DEG=90

# Audio
# AUDIO_DEVICE=0                              # input device index; see sd.query_devices()
# AUDIO_TEST_WAV=tools/sample_hello.wav       # use this file instead of the microphone

# Window
# FULLSCREEN=1        # cover the whole display, no title bar
# ESC_QUITS=1         # ESC closes the app (0 = ESC cancels the current job instead)

# Arcade button: switch on BUTTON_PIN (BCM number, default 27) to ground;
# its light through a transistor on BUTTON_LED_PIN (default 17, empty = no light)
# BUTTON_PIN=27
# BUTTON_LED_PIN=17

# Pre-recorded stories (folder layout in services/story_library.py).
# Check a folder with: venv/bin/python -m services.story_library
# STORIES_DIR=/home/karthik/Wonder-Box/stories

# App sounds in assets/sounds/ (boot, waiting_loop, ready). Make them from
# Gemini tracks with tools/prepare_sounds.py. SOUNDS=0 turns them off.
# SOUNDS=1
# SOUND_VOLUME=0.8

# Background behind the start, listening, thinking and error screens
# (sticker and story pictures are shown without it). "none" = plain white.
# SCREEN_BACKGROUND=assets/images/background.png
