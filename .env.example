# WonderBox cloud backend (services/backend_client.py)
# The Pi no longer calls OpenAI or runs Whisper; the backend does both.
BACKEND_URL=http://192.168.1.20:8000
# Raw token returned once by POST /device/register
DEVICE_TOKEN=your-device-token-here
# Child profile id the backend requires on every sticker submit
CHILD_ID=1

# Printer (optional)
# PRINTER_PORT=/dev/ttyUSB0
# PRINTER_SIMULATE=0
# Pause after each 1,160-byte strip, seconds
# PRINTER_STRIP_DELAY=0.08
